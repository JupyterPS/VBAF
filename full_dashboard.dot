digraph CompanyStructure {
    rankdir=TB;
    splines=false;

    node [style=filled, fontname="Arial", fontsize=12];
    edge [fontname="Arial", fontsize=10];
    graph [margin=0.7];

    "CompanyBase" [shape=box, style=filled, fillcolor="gold:lightgrey", gradientangle=0, fontsize=10, fontcolor=black, width=5, height=0.75]; 
    "CompanyOperations" [shape=box, color=lightgrey, style=filled, fontsize=10, fontcolor=black, width=5, height=0.75];
    "CompanyDataBase" [shape=box, style=filled, fillcolor="lightgrey:gold", gradientangle=0, fontsize=10, fontcolor=black, width=5, height=0.75]; 

    "CompanyBase" -> "CompanyHeadquarters" [color=grey, style=dashed, label="Supports"];
    "CompanyOperations" -> "CompanyHeadquarters" [color=grey, style=dashed, label="Supports"];
    "CompanyDataBase" -> "CompanyHeadquarters" [color=grey, style=dashed, label="Supports"];    

    "CompanyHeadquarters" [shape=box, color="lightblue", style=filled, fontsize=16, fontcolor=black, width=3, height=1];

    ". " [shape=box, color=invis, style=filled, fontsize=16, width=4.4, height=0.9];
    "Novo Nordisk" [shape=box, color=yellow, style=filled, fontsize=12, width=3.0, height=0.9];
    "Wine Company" [shape=box, color=lightgreen, style=filled, fontsize=12, width=3.0, height=0.9];
    "Commerce Bank" [shape=box, color=gold1, style=filled, fontsize=12, width=3.0, height=0.9];
    "AI Company" [shape=box, color=greenyellow, style=filled, fontsize=12, width=3.0, height=0.9];
    " ." [shape=box, color=invis, style=filled, fontsize=16, width=5.4, height=0.9];

    "CompanyHeadquarters" -> ". " [color=invis, style=dashed];
    "CompanyHeadquarters" -> "Novo Nordisk" [color=grey, style=dashed];
    "CompanyHeadquarters" -> "Wine Company" [color=grey, style=dashed];
    "CompanyHeadquarters" -> "Commerce Bank" [color=grey, style=dashed];
    "CompanyHeadquarters" -> "AI Company" [color=grey, style=dashed];
    "CompanyHeadquarters" -> " ." [color=invis, style=dashed];

    // Company classes and functions (simplified example)
    "Company1 Class" [shape=box, color=yellow, style=filled, fontsize=12, label="Class: Company1\nMethods:\n- AddCustomer\n- AddOrder"];
    "Company1 Functions Box" [shape=box, color=orange, style=filled, fontsize=12, label="Functions:\n- Company1\n- SalesReport"];

    "Novo Nordisk" -> "Company1 Class" [color=grey, style=dashed];
    "Company1 Class" -> "Company1 Functions Box" [color=grey50, style=dashed];

    "Company2 Class" [shape=box, color=lightgreen, style=filled, fontsize=12, label="Class: Company2\nMethods:\n- AddInventory\n- ProcOrder"];
    "Company2 Functions Box" [shape=box, color=orange, style=filled, fontsize=12, label="Functions:\n- Company2\n- StockCheck"];

    "Wine Company" -> "Company2 Class" [color=grey, style=dashed];
    "Company2 Class" -> "Company2 Functions Box" [color=grey50, style=dashed];

    "Company3 Class" [shape=box, color=gold1, style=filled, fontsize=12, label="Class: Company3\nMethods:\n- AddAcc\n- Deposit"];
    "Company3 Functions Box" [shape=box, color=orange, style=filled, fontsize=12, label="Functions:\n- Company3\n- TransferFunds"];

    "Commerce Bank" -> "Company3 Class" [color=grey, style=dashed];
    "Company3 Class" -> "Company3 Functions Box" [color=grey50, style=dashed];

    "Company4 Class" [shape=box, color=greenyellow, style=filled, fontsize=12, label="Class: Company4\nMethods:\n- Classify\n- MachineLearning"];
    "Company4 Functions Box" [shape=box, color=orange, style=filled, fontsize=12, label="Functions:\n- Company4\n- AIModel"];

    "AI Company" -> "Company4 Class" [color=grey, style=dashed];
    "Company4 Class" -> "Company4 Functions Box" [color=grey50, style=dashed];
}
