digraph CompanyStructure {
    rankdir=TB;

    // Global node and edge settings
    node [style=filled, fontname="Arial", fontsize=12];
    edge [fontname="Arial", fontsize=10];

    // Wedge node at the top
    "wedge" [shape=box, color=grey, style=filled, fontsize=10, width=5, height=0.1];

    // Main nodes
    "CompanyBase" [shape=box, style=filled, fillcolor="gold:lightgrey", fontsize=10, width=5, height=0.75];
    "CompanyOperations" [shape=box, style=filled, fillcolor=lightgrey, fontsize=10, width=5, height=0.75];
    "CompanyDataBase" [shape=box, style=filled, fillcolor="lightgrey:gold", fontsize=10, width=5, height=0.75];

    // Connections
    "wedge" -> "CompanyBase" [color=invis, style=dashed];
    "CompanyBase" -> "CompanyHeadquarters" [color=grey, style=dashed];
    "CompanyOperations" -> "CompanyHeadquarters" [color=grey, style=dashed];
    "CompanyDataBase" -> "CompanyHeadquarters" [color=grey, style=dashed];

    // Central headquarters node
    "CompanyHeadquarters" [shape=box, color="lightblue", style=filled, fontsize=16, width=3, height=1];

    // Companies
    "Novo Nordisk" [shape=box, color=yellow, style=filled, fontsize=12, width=3.0, height=0.9];
    "Wine Company" [shape=box, color=lightgreen, style=filled, fontsize=12, width=3.0, height=0.9];
    "Commerce Bank" [shape=box, color=gold1, style=filled, fontsize=12, width=3.0, height=0.9];
    "AI Company" [shape=box, color=greenyellow, style=filled, fontsize=12, width=3.0, height=0.9];

    // Connecting headquarters to companies
    "CompanyHeadquarters" -> "Novo Nordisk" [color=grey, style=dashed];
    "CompanyHeadquarters" -> "Wine Company" [color=grey, style=dashed];
    "CompanyHeadquarters" -> "Commerce Bank" [color=grey, style=dashed];
    "CompanyHeadquarters" -> "AI Company" [color=grey, style=dashed];
}
