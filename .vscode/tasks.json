{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run PowerShell Externally",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Run PowerShell As Admin",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "Start-Process PowerShell -ArgumentList '-File', '${file}' -Verb RunAs"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
