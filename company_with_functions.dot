
digraph CompanyStructure {
    rankdir=TB; // Set the layout to top-to-bottom (vertical flow)
    splines=false; // Disable curved edges globally, ensuring straight lines
    
    // Global node and edge settings
    node [style=filled, fontname="Arial", fontsize=12];
    edge [fontname="Arial", fontsize=10];

    // Set graph margin to control space between graph and edges
    graph [margin=0.7] // Adjust as needed to control the gap above the graph

    // Main nodes with specific dimensions and attributes
    "CompanyBase" [shape=box, style=filled, fillcolor="gold:lightgrey", gradientangle=0, fontsize=10, fontcolor=black, width=5, height=0.75]; 
    "CompanyOperations" [shape=box, color=lightgrey, style=filled, fontsize=10, fontcolor=black, width=5, height=0.75];
    "CompanyDataBase" [shape=box, style=filled, fillcolor="lightgrey:gold", gradientangle=0, fontsize=10, fontcolor=black, width=5, height=0.75]; 

    // Connect CompanyBase and other modules to CompanyHeadquarters
    "CompanyBase" -> "CompanyHeadquarters" [color=grey, style=dashed, label="Supports"];
    "CompanyOperations" -> "CompanyHeadquarters" [color=grey, style=dashed, label="Supports"];
    "CompanyDataBase" -> "CompanyHeadquarters" [color=grey, style=dashed, label="Supports"];    

    // Central headquarters node
    "CompanyHeadquarters" [shape=box, color="lightblue", style=filled, fontsize=16, fontcolor=black, width=3, height=1];

    // Companies with specific attributes and spacing for clarity
    ". " [shape=box, color=invis, style=filled, fontsize=16, width=4.4, height=0.9];
    "Novo Nordisk" [shape=box, color=yellow, style=filled, fontsize=12, width=3.0, height=0.9];
    "Wine Company" [shape=box, color=lightgreen, style=filled, fontsize=12, width=3.0, height=0.9];
    "Commerce Bank" [shape=box, color=gold1, style=filled, fontsize=12, width=3.0, height=0.9];
    "AI Company" [shape=box, color=greenyellow, style=filled, fontsize=12, width=3.0, height=0.9];
    " ." [shape=box, color=invis, style=filled, fontsize=16, width=5.4, height=0.9];

    // Connecting headquarters to companies
    "CompanyHeadquarters" -> ". " [color=invis, style=dashed];
    "CompanyHeadquarters" -> "Novo Nordisk" [color=grey, style=dashed];
    "CompanyHeadquarters" -> "Wine Company" [color=grey, style=dashed];
    "CompanyHeadquarters" -> "Commerce Bank" [color=grey, style=dashed];
    "CompanyHeadquarters" -> "AI Company" [color=grey, style=dashed];
    "CompanyHeadquarters" -> " ." [color=invis, style=dashed];

    // Detailed classes and methods for Company1 (Novo Nordisk in this example)
    "Company1 Class" [shape=box, color=yellow, style=filled, fontsize=12, label="Class: Company1\n\nMethods:\n- AddCustomer\n- AddOrder\n- AddProduct\n- AddStaff\n- AddTicket\n- AssignTicket\n- ListOrders\n- ListProducts\n- ListTickets\n- UpdateStock\n- TicketStatus"];

    // Company1 Additional Classes box
    "Company1 Additional Classes" [shape=box, color=darkolivegreen1, style=filled, fontsize=12, label="Classes:\n- Company1\n- Customer\n- Inheriting\n- Order"];

    // Company1 Functions (dedicated box for functions)
    "Company1 Functions Box" [shape=box, color=orange, style=filled, fontsize=12, label="Functions:\n- Company1\n- SalesReport\n- Message"];

    // Connect the Novo Nordisk node to the detailed Company1 class node
    "Novo Nordisk" -> "Company1 Class" [color=grey, style=dashed, label="Classes and Methods"];

    // Connect Company1 Class to Additional Classes
    "Company1 Class" -> "Company1 Additional Classes" [color=grey50, style=dashed, label="Additional Classes"];
    
    // Connect methods box to functions box
    "Company1 Class" -> "Company1 Functions Box" [color=grey50, style=dashed, label="Functions"];

    // Detailed classes and methods for Company2 (Wine Company in this example)
    "Company2 Class" [shape=box, color=lightgreen, style=filled, fontsize=12, label="Class: Company2\n\nMethods:\n- AddInventory\n- AddWine\n- Inventory\n- Prices\n- CustomInquir\n- SuppTickets\n- ListWines\n- CustomSupp\n- ProcOrder\n- ReorderWine\n- UpdatePrice\n- UpdateStock"];

    // Company2 Additional Classes box
    "Company2 Additional Classes" [shape=box, color=darkolivegreen2, style=filled, fontsize=12, label="Classes:\n- Company2\n- Order\n- Customer"];

    // Connect the Wine Company node to the detailed Company2 class node
    "Wine Company" -> "Company2 Class" [color=grey, style=dashed, label="Classes and Methods"];

    // Connect Company2 Class to Additional Classes
    "Company2 Class" -> "Company2 Additional Classes" [color=grey50, style=dashed, label="Additional Classes"];

    // Company2 Functions (dedicated box for functions)
    "Company2 Functions Box" [shape=box, color=orange, style=filled, fontsize=12, label="Functions:\n- Company2\n- AddInventory\n- StockCheck"];

    // Connect methods box to functions box
    "Company2 Class" -> "Company2 Functions Box" [color=grey50, style=dashed, label="Functions"];

    // Detailed classes and methods for Company3 (Commerce Bank in this example)
    "Company3 Class" [shape=box, color=gold1, style=filled, fontsize=12, label="Class: Company3\n\nMethods:\n- AddAcc\n- Interest\n- Deposit\n- Accounts\n- CompanyInfo\n- LoanDetails\n- Loans\n- LogTransaction\n- MakePayment\n- Repay\n- RepayLoan\n- Transfer\n- CustomerEmail\n- Withdraw"];

    // Company3 Additional Classes box
    "Company3 Additional Classes" [shape=box, color=darkolivegreen3, style=filled, fontsize=12, label="Classes:\n- Company3\n- Loan\n- Account\n- CheckingAcc\n- LoanAcc\n- SavingsAcc"];
    
    // Connect the Commerce Bank node to the detailed Company3 class node
    "Commerce Bank" -> "Company3 Class" [color=grey, style=dashed, label="Classes and Methods"];

    // Connect Company3 Class to Additional Classes
    "Company3 Class" -> "Company3 Additional Classes" [color=grey50, style=dashed, label="Additional Classes"];
    
    // Company3 Functions (dedicated box for functions)
    "Company3 Functions Box" [shape=box, color=orange, style=filled, fontsize=12, label="Functions:\n- Company3\n- TransferFunds\n- WithdrawCash"];
    
    // Connect methods box to functions box
    "Company3 Class" -> "Company3 Functions Box" [color=grey50, style=dashed, label="Functions"];

    // Detailed classes and methods for Company4 (AI Company in this example)
    "Company4 Class" [shape=box, color=greenyellow, style=filled, fontsize=12, label="Class: Company4\n\nMethods:\n- Classify\n- DataSources\n- MachineLearning\n- AIResearch\n- DataMining\n- DataScience\n- Algorithms\n- CodeScan\n- Models\n- Results"];

    // Connect the AI Company node to the detailed Company4 class node
    "AI Company" -> "Company4 Class" [color=grey, style=dashed, label="Classes and Methods"];

    // Company4 Additional Classes box
    "Company4 Additional Classes" [shape=box, color=darkolivegreen4, style=filled, fontsize=12, label="Classes:\n- Company4\n- Research\n- Project\n- Collaboration"];
    
    // Connect Company4 Class to Additional Classes
    "Company4 Class" -> "Company4 Additional Classes" [color=grey50, style=dashed, label="Additional Classes"];
    
    // Company4 Functions (dedicated box for functions)
    "Company4 Functions Box" [shape=box, color=orange, style=filled, fontsize=12, label="Functions:\n- Company4\n- AIModel\n-ActiveNeuron"];

    // Connect methods box to functions box
    "Company4 Class" -> "Company4 Functions Box" [color=grey50, style=dashed, label="Functions"];
}
